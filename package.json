{
  "name": "api-libros",
  "version": "1.1.0",
  "description": "API REST de libros (Express + MySQL) desplegada en Amazon EC2 con Amazon RDS y CI/CD con GitHub Actions",
  "main": "src/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "RUN_INTEGRATION=1 jest tests/integration"
  },
  "type": "commonjs",
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      }
    }
  }
}
